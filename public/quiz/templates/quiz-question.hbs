<article class="quiz-question{{#if review}} review-mode{{/if}}">
  <h2>{{addOne index}}. {{{question}}}</h2>
  {{#if (equals type "short-answer")}}
  <input type="text" name="{{id}}" {{#if review}}value="{{correctAnswer}}" {{/if}}>
  {{else}}
  <div class="quiz-options">
    {{#each options}}
    <label>
      <input type="{{#if (equals ../type "multi-select")}}checkbox{{else}}radio{{/if}}" name="{{../id}}" value="{{id}}"
        {{#if ../review}} {{#if (equals ../type "multi-select" )}} 
        {{#if (includes ../correctOptionIds id)}}checked{{/if}}
        {{else}} {{#if (equals id ../correctOptionId)}}checked{{/if}} {{/if}} {{#if (equals
        ../type "true-false" )}} {{#if (equals id ../correctAnswer)}}checked{{/if}} {{/if}} {{/if}}>
      {{text}}
    </label>
    {{/each}}
  </div>
  {{/if}}
</article>