<table>
  <thead>
    <tr>
      <th>Type</th>
      <th>Question</th>

      {{#if showOwner}}
        <th>Owner</th>
      {{/if}}

      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    {{#each questions}}
      <tr data-id="{{_id}}">
        <td>{{type}}</td>
        <td>{{{question}}}</td>

        {{#if ../showOwner}}
          <td>{{ownerEmail}}</td>
        {{/if}}

        <td>
          <button type="button" class="edit-btn">Edit</button>
          <button type="button" class="delete-btn">Delete</button>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>