<article class="deployment-item">
  <h3>
    <button type="button" class="deployment-view-btn">
      {{name}}
    </button>
  </h3>
  <p>Status: {{status}}</p>
  <p>Created: {{created}}</p>
  <p>Template: {{template.id}} ({{template.version}})</p>
  <p>URL: <a href="{{url}}" target="_blank">{{url}}</a></p>
</article>