<section id="login-view">
  <h2>Log in</h2>
  <form id="login-form">
    <label>Email
      <input
        type="email"
        id="login-email"
        autocomplete="email"
        required
      /></label>
    <label>Password
      <input
        type="password"
        id="login-password"
        autocomplete="current-password"
        required
      /></label>
    <button type="submit">Log in</button>
  </form>
  <p id="login-error" class="error"></p>
</section>